# JMCFI PostFlow — Frontend Environment Variables
# Copy this file to .env and adjust the values for your local setup.
#
# Base URL of the Laravel backend API.
# - Web (same machine): use 127.0.0.1 (NOT localhost) to avoid the IPv6->IPv4
#   fallback delay on Windows: http://127.0.0.1:8000/api
# - Physical device via LAN: http://<your-lan-ip>:8000/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
